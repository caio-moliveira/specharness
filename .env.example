# === specharness — variáveis de ambiente ===
# Copie para .env e preencha o que for usar. Keys NUNCA vão em specharness.yaml.

# Banco (default: SQLite local, zero-config — nada a preencher)
# SPECHARNESS_DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/specharness

# LLM (obrigatório: UM provedor de API OU Ollama local — ADR-006)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# OLLAMA_BASE_URL=http://localhost:11434

# Conexões (preencha as que o projeto usar)
# GITHUB_TOKEN=
# REDMINE_URL=
# REDMINE_API_KEY=
# JIRA_URL=
# JIRA_TOKEN=

# Observabilidade (opcional, off por default)
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
